<Window x:Class="Restaurant_Manager.Views.OrderView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Restaurant_Manager.Views"
        mc:Ignorable="d"
        Title="OrderView" Height="450" Width="800">
    <Grid Margin="10">

        <StackPanel>
            <TextBlock Text="Замовлення" FontSize="20" Margin="0,0,0,10"/>
            <ListView ItemsSource="{Binding Orders}" Height="250">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Id}" Width="50"/>
                            <TextBlock Text="{Binding Table.Number}" Width="80"/>
                            <TextBlock Text="{Binding User.Name}" Width="150"/>
                            <TextBlock Text="{Binding Status}" Width="100"/>


                            <TextBlock Text="{Binding TotalAmount}" Width="80"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

    </Grid>
</Window>
