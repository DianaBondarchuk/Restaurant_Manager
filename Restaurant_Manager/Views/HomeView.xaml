<Window x:Class="Restaurant_Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restaurant Manager" Height="600" Width="900">
    <DockPanel>
        
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#FF004E89" Height="45">
            <Button Content="Home" Click="Home_Click" Margin="10" Foreground="White"/>
            <Button Content="Menu" Click="Menu_Click" Margin="10" Foreground="White"/>
            <Button Content="Users" Click="Users_Click" Margin="10" Foreground="White"/>
            <Button Content="Orders" Click="Orders_Click" Margin="10" Foreground="White"/>
            <Button Content="Reports" Click="Reports_Click" Margin="10" Foreground="White"/>
        </StackPanel>

        
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>
</Window>
